# Firebase (frontend — requieren prefijo VITE_ para ser accesibles desde el navegador)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# AWS SES (solo servidor — sin prefijo VITE_ para que nunca lleguen al frontend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SES_FROM=
